# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# NUNCA suba o .env de verdade pro Git (coloque no .gitignore).

# String de conexão do PostgreSQL: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://apollo_user:apollo_dev_pass@localhost:5432/apollo_db

# Chave usada para assinar os tokens JWT. Gere uma própria em produção, por
# exemplo com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-esta-chave-antes-de-ir-para-producao
JWT_ALGORITHM=HS256
JWT_EXPIRA_MINUTOS=120

# Origens autorizadas a chamar a API (o front-end estático, quando servido
# separadamente). Separe múltiplas origens por vírgula.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
